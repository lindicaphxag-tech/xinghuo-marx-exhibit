    },
    {
      "label": "Date de production",
      "value": "<div class=\"pm-date-precision\">\n      <span class=\"precision\">Vers</span>\n  \n                            <span class=\"year\">1860</span>\n        \n  </div>\n"
    },
    {
      "label": "Datation en siècle",
      "value": "2e moitié du 19e siècle"
    },
    {
      "label": "Époque/Période",
      "value": "Second Empire (1852-1870) (France)"
    },
    {
      "label": "Description",
      "value": [
        "<p>Maquette en bois avec éléments rapportés en carton, métal et papier gaufré ; capot en bois et verre ancien.</p>\n"
      ]
    },
    {
      "label": "Description iconographique",
      "value": [
        "<p>L'Hôtel de Ville : l'édifice est représenté avec ses huit pavillons, trois cours intérieures, une grille entourant le bâtiment.</p>\n"
      ]
    },
    {
      "label": "Commentaire historique",
      "value": [
        "<p>Provient du bureau de M. Darras à l'Hôtel de Ville.</p>\n"
      ]
    },
    {
      "label": "Dimensions",
      "value": [
        "Oeuvre - Hauteur 32 cm",
        "Oeuvre - Largeur 42.5 cm",
        "Oeuvre - Profondeur 29 cm"
      ]
    },
    {
      "label": "Matériaux et techniques",
      "value": [
        "Bois (matériau)",
        "Carton",
        "Métal"
      ]
    },
    {
      "label": "Inscriptions",
      "value": [
        "Cartouche - <p>Cartouche rapporté en partie supérieure du capot en bois et verre ancien, au centre : \"HOTEL DE VILLE DE PARIS\".</p>\n",
        "Cartouche - <p>Cartouches rapportés en partie supérieure du capot en bois et verre ancien, encadrant le précédent : \"MÉDAILLE\" ; \"D'ARGENT\".</p>\n",
        "Numéro - <p>En partie supérieure du capot : \"E 1938-15738\".</p>\n"
      ]
